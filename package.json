{
  "name": "nuxt-fakestoreapi",
  "description": "A secure-by-default Nuxt storefront demo powered by Fake Store API.",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=12.2.1"
  },
  "scripts": {
    "build": "nuxt build",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test:security": "node --test tests/security.test.mjs",
    "test:server": "node --test tests/request-body.test.mjs",
    "test:cart": "node --test tests/cart.test.mjs",
    "audit:security": "node scripts/audit-security.mjs"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.3",
    "h3": "^1.15.11",
    "nuxt": "^4.6.4",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vue-tsc": "^3.3.14"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "@intlify/unplugin-vue-i18n": {
      "@intlify/vue-i18n-extensions": "^9.0.1"
    },
    "glob": "^14.0.4",
    "minimatch": "^11.0.5",
    "node-forge": "^1.4.3"
  },
  "patchedDependencies": {
    "braces@3.0.3": "patches/braces@3.0.3.patch",
    "deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch"
  }
}
