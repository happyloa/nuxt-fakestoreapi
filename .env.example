# Public origin used for canonical, hreflang, og:url and share-image URLs.
NUXT_PUBLIC_I18N_BASE_URL=https://nuxt-fakestoreapi.worksbyaaron.com

# Server-only upstream API endpoint. The browser only calls this app's /api routes.
NUXT_FAKE_STORE_API_BASE=https://fakestoreapi.com

# Server-only key for sealed session cookies (at least 32 characters).
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=
