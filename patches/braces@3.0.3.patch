+// Local mitigation for GHSA-vfj7-8cjw-p6xm. Parent links are not traversed.
+exports.assertDepth = ast => {
+  const pending = [[ast, 0]];
+  const seen = new WeakSet();
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (depth > 128 || seen.has(node)) {
+      throw new SyntaxError('Brace nesting exceeds the safe depth limit');
+    }
+    seen.add(node);
+    if (node.nodes) {
+      for (const child of node.nodes) pending.push([child, depth + 1]);
+    }
+  }
